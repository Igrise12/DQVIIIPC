{
  "problemMatcher": [
    {
      "owner": "dq8-msvc",
      "pattern": [
        {
          "regexp": "^\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?(error|warning)\\s+([A-Z]+\\d+)\\s*:\\s*(.*?)(?:\\s+\\[.*\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    },
    {
      "owner": "dq8-msvc-link",
      "pattern": [
        {
          "regexp": "^\\s*(.+?)\\s*:\\s+(?:fatal\\s+)?(error|warning)\\s+((?:LNK|CVT|RC)\\d+)\\s*:\\s*(.*?)(?:\\s+\\[.*\\])?$",
          "file": 1,
          "severity": 2,
          "code": 3,
          "message": 4
        }
      ]
    }
  ]
}
