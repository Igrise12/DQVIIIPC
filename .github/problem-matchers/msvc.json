{
  "problemMatcher": [
    {
      "owner": "dq8-msvc",
      "pattern": [
        {
          "regexp": "^\\s*(.+?)\\((\\d+)(?:,(\\d+))?\\)\\s*:\\s+(?:fatal\\s+)?(error|warning)\\s+([A-Z]+\\d+)\\s*:\\s*(.*?)(?:\\s+\\[.*\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
