# Local tool and input paths for contributor scripts under tools/.
# Copy this file to tools/local.env (git-ignored) and fill in your own paths.
# Every tools/*/ script sources tools/local.env if it exists. Nothing here is read
# by the end-user setup path or by the game; players never need this file.

# Your own disc image (never committed; the repository's .gitignore excludes it).
DQ8_ISO="/path/to/Dragon Quest VIII - Journey of the Cursed King (USA).iso"

# Ghidra 12.1.x install with the ghidra-emotionengine-reloaded extension installed
# under Ghidra/Extensions/. Used by tools/ghidra/headless.sh and by REA (GHIDRA_INSTALL_DIR).
DQ8_GHIDRA_INSTALL_DIR="/opt/ghidra_12.1.4_PUBLIC"

# Optional: a JDK to prefer over the one on PATH (Ghidra needs JDK 21 or newer).
#DQ8_JAVA_HOME="/usr/lib/jvm/java-21-openjdk"

# PCSX2 2.x. Either an extracted AppImage tree (AppRun) or the AppImage itself;
# tools/pcsx2/headless_run.py extracts the AppImage into work/pcsx2/ if AppRun is missing.
DQ8_PCSX2_APPRUN="/path/to/pcsx2/squashfs-root/AppRun"
DQ8_PCSX2_APPIMAGE="/path/to/pcsx2-v2.x-linux-appimage-x64-Qt.AppImage"

# Your own PS2 BIOS dump (never committed). Only tools/pcsx2/ reads it; the native port does not use a BIOS.
DQ8_PS2_BIOS="/path/to/SCPH-xxxxx.ROM0"
